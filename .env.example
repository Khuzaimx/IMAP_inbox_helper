# -----------------------------------------------------------------------------
# IMAP Inbox Helper - Configuration
# -----------------------------------------------------------------------------

# --- IMAP Connection Settings ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SSL=True
IMAP_USER=your_email@gmail.com
# For Gmail, generate a 16-character App Password (DO NOT use your main password)
IMAP_PASSWORD=your_app_password

# --- Folder Monitoring Settings ---
MONITOR_FOLDER=INBOX
# Interval in seconds to poll for fallback (used if IMAP IDLE is interrupted)
POLL_INTERVAL=300

# --- Classification Scoring Engine ---
# Emails scoring equal to or above this threshold are classified as IMPORTANT
IMPORTANCE_THRESHOLD=50

# --- Custom Whitelists & Blacklists ---
# Comma-separated domains or email addresses that are ALWAYS treated as important
WHITELIST_SENDERS=john.doe@company.com,myboss@work.com

# Comma-separated words or domains that are ALWAYS flagged as clutter/newsletter
BLACKLIST_SENDERS=glassdoor,indeed,aliexpress,newsletter,noreply@,no-reply@
